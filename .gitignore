.env
.env.*
*.env
!.env.example
!example.env
!.env.template

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
backend/crm.db
crm.db

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
.npm
.pnpm-store
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo

# --- Logs & Runtime Artifacts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
